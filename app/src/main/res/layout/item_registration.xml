<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <!-- 🌟 1. 活动名称（加粗且防溢出） -->
            <TextView
                android:id="@+id/tv_record_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动名称加载中..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 🌟 2. 申请时间（加入辅助图标感） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/text_hint"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tv_record_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请时间：2026-05-01"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🌟 3. 状态和操作区 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_record_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_edittext_rounded"
                android:text="待审核"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_cancel_reg"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="56dp"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:text="取消"
                android:textSize="11sp"
                android:textColor="@color/bg_white"
                android:background="@drawable/bg_button_danger"
                android:stateListAnimator="@null"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>