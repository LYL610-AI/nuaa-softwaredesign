<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🌟 1. 上半部分：申请人信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 志愿者头像占位 -->
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary_blue"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="志"
                    android:textColor="@color/bg_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_apply_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请人：张三"
                    android:textSize="16sp"
                    android:textColor="@color/text_main"
                    android:textStyle="bold" />

                <!-- 增加防溢出保护，防止项目名称过长 -->
                <TextView
                    android:id="@+id/tv_apply_project"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请项目：大凉山支教"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🌟 2. 审核状态指示 -->
        <TextView
            android:id="@+id/tv_audit_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待审核"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:layout_marginTop="8dp" />

        <!-- 🌟 3. 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_gray"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- 🌟 4. 下半部分：操作按钮组 (靠右对齐) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- 驳回按钮 (小红胶囊) -->
            <Button
                android:id="@+id/btn_reject"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="70dp"
                android:paddingHorizontal="12dp"
                android:text="驳回"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_danger"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginEnd="12dp" />

            <!-- 通过按钮 (小绿胶囊) -->
            <Button
                android:id="@+id/btn_approve"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="70dp"
                android:paddingHorizontal="12dp"
                android:text="通过"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_success"
                app:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>