<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app"> <!-- 统一浅灰背景色 -->

    <!-- 🌟 1. 顶部悬浮标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="3dp"
        android:paddingVertical="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学校管理后台"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 🌟 2. 学校信息展示卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <!-- 模拟的学校图标 -->
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="校"
                        android:textColor="@color/bg_white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_school_display_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未设置学校名称"
                            android:textSize="20sp"
                            android:textColor="@color/text_main"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tv_auth_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● 资质待审核"
                            android:textColor="#FF9800"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="常用功能"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:layout_marginBottom="15dp"
                android:paddingHorizontal="5dp"/>

            <!-- 🌟 3. 功能大按钮：应用了胶囊背景的同时保留了色彩区分 -->
            <Button
                android:id="@+id/btn_to_add_activity"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="➕ 发布新的支教项目"
                android:textColor="@color/bg_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#4CAF50"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_to_manage_volunteers"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="📋 审核志愿者申请"
                android:textColor="@color/bg_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_to_my_published"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="📝 管理已发布活动"
                android:textColor="@color/bg_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#FF9800"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_browse_approved"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="🔍 浏览已审核招募信息"
                android:textColor="@color/bg_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_edit_school_info"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="✏️ 编辑学校信息"
                android:textColor="@color/bg_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#607D8B"
                android:stateListAnimator="@null"
                android:layout_marginBottom="30dp" />

            <!-- 将退出按钮推到底部的占位符 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 🌟 4. 退出登录按钮 (红色警示胶囊) -->
            <Button
                android:id="@+id/btn_school_logout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="退出登录"
                android:textColor="@color/bg_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_danger"
                android:stateListAnimator="@null"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>