<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="帖子标题"
            android:textSize="16sp"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布者 / 时间 / 状态"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_approve"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="60dp"
                android:paddingHorizontal="12dp"
                android:text="通过"
                android:textSize="13sp"
                android:textColor="@color/text_main"
                android:background="@drawable/bg_button_success"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="60dp"
                android:paddingHorizontal="12dp"
                android:text="驳回"
                android:textSize="13sp"
                android:textColor="@color/text_main"
                android:background="@drawable/bg_button_danger"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="60dp"
                android:paddingHorizontal="12dp"
                android:text="删除"
                android:textSize="13sp"
                android:textColor="@color/bg_white"
                android:background="@drawable/bg_button_danger"
                android:stateListAnimator="@null"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btn_view_detail"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="72dp"
                android:paddingHorizontal="12dp"
                android:text="查看详情"
                android:textSize="13sp"
                android:textColor="@color/bg_white"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
