<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编写活动总结报告"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_main"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提交后需管理员审核，通过后活动状态变更为「结束」"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"/>

        <!-- 活动信息展示卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="活动信息"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tv_summary_activity_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="项目名称："
                    android:textSize="14sp"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_summary_activity_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支教时间："
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_summary_activity_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支教地址："
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 总结编辑区 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="总结报告内容"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_summary_content"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:hint="请按照以下模板编写总结报告：\n\n1. 支教活动整体情况概述\n2. 实际参与志愿者人数及教学成果\n3. 受益学生人数及反馈\n4. 遇到的困难与解决方案\n5. 经验总结与改进建议\n6. 活动照片或影像资料说明（如有）"
                    android:gravity="top"
                    android:textColorHint="@color/text_hint"
                    android:padding="15dp"
                    android:background="@drawable/bg_edittext_rounded"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_submit_summary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="20dp"
            android:text="提交总结（需管理员审核）"
            android:textColor="@color/bg_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>
