<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app"
    android:gravity="center_vertical"
    android:padding="25dp">

    <!-- 🌟 1. 品牌大标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="支教信息发布系统"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primary_blue"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="欢迎登录"
        android:textSize="16sp"
        android:textColor="@color/text_sub"
        android:layout_gravity="center"
        android:layout_marginBottom="35dp"/>

    <!-- 🌟 2. 悬浮的白色登录卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/bg_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingVertical="35dp">

            <!-- 账号输入框 -->
            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edittext_rounded"
                android:hint="请输入手机号"
                android:inputType="phone"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_main"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="20dp"
                android:maxLines="1"
                android:singleLine="true"/>

            <!-- 密码输入框 -->
            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edittext_rounded"
                android:hint="请输入密码"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_main"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="20dp"
                android:maxLines="1"
                android:singleLine="true"/>

            <!-- 角色选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登录身份"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>
            <RadioGroup
                android:id="@+id/rg_login_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="25dp">
                <RadioButton
                    android:id="@+id/rb_volunteer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="志愿者"
                    android:textColor="@color/text_main"
                    android:checked="true"/>
                <RadioButton
                    android:id="@+id/rb_school"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="学校"
                    android:textColor="@color/text_main"/>
                <RadioButton
                    android:id="@+id/rb_admin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="管理员"
                    android:textColor="@color/text_main"/>
            </RadioGroup>

            <!-- 蓝色的胶囊大按钮 -->
            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="立即登录"
                android:textColor="@color/bg_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 将这段代码放在 btn_login 和 tv_go_register 之间 -->
    <TextView
        android:id="@+id/tv_forgot_pwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="忘记密码？重置密码"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_blue"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:padding="8dp"/> <!-- 增加 padding 扩大手指点击热区 -->

    <!-- 🌟 3. 去注册的入口（增加 padding 扩大手指点击区域） -->
    <TextView
        android:id="@+id/tv_go_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="没有账号？点此注册"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:textColor="@color/primary_blue"
        android:padding="10dp"/>


</LinearLayout>