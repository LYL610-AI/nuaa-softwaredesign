<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"> <!-- 统一浅灰背景 -->

    <!-- 🌟 1. 顶部悬浮标题栏 (改为 RelativeLayout) -->
    <RelativeLayout
        android:id="@+id/layout_community_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="3dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <!-- 新增：左上角返回首页按钮 -->
        <TextView
            android:id="@+id/btn_back_to_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="‹ 首页"
            android:textSize="16sp"
            android:textColor="@color/primary_blue"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground" />

        <!-- 居中：页面标题 -->
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="支教朋友圈"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />
    </RelativeLayout>

    <!-- 🌟 2. 帖子列表区：增加两侧留白和 padding -->
    <!-- 【检查点】ID 必须是 rv_posts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_posts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_community_top_bar"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

    <!-- 🌟 3. 悬浮发帖按钮 -->
    <!-- 【检查点】ID 必须是 fab_add_post -->
    <!-- paddingBottom=80dp 是为了防止列表最下面的项被这个悬浮按钮挡住 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        app:srcCompat="@android:drawable/ic_menu_edit"
        app:tint="@color/bg_white"
        app:backgroundTint="@color/primary_blue"
        app:elevation="6dp" />

</RelativeLayout>