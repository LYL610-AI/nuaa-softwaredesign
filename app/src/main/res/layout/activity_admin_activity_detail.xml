<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/bg_white"
        android:elevation="3dp"
        android:paddingVertical="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_detail_title_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="活动详情"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />
    </LinearLayout>

    <!-- 底部审核按钮 -->
    <LinearLayout
        android:id="@+id/layout_audit_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/bg_white"
        android:elevation="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_audit_reject"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="驳回"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_edittext_rounded"
            android:stateListAnimator="@null"
            android:layout_marginEnd="12dp"/>

        <Button
            android:id="@+id/btn_audit_approve"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="通过"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bg_white"
            android:background="@drawable/bg_button_success"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- 中间内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar"
        android:layout_above="@id/layout_audit_buttons"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 封面图片 -->
            <ImageView
                android:id="@+id/iv_detail_cover"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 活动标题 -->
                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="活动标题"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginBottom="12dp"/>

                    <!-- 发布学校 -->
                    <TextView
                        android:id="@+id/tv_detail_school"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="发布学校："
                        android:textSize="14sp"
                        android:textColor="@color/text_sub"
                        android:layout_marginBottom="6dp"/>

                    <!-- 学校地址 -->
                    <TextView
                        android:id="@+id/tv_detail_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="学校地址："
                        android:textSize="14sp"
                        android:textColor="@color/text_sub"
                        android:layout_marginBottom="6dp"/>

                    <!-- 招募信息行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tv_detail_recruits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="招募人数："
                            android:textSize="14sp"
                            android:textColor="@color/text_sub"
                            android:layout_marginEnd="20dp"/>

                    </LinearLayout>

                    <!-- 活动日期 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tv_detail_start_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开始："
                            android:textSize="14sp"
                            android:textColor="@color/text_sub"
                            android:layout_marginEnd="20dp"/>

                        <TextView
                            android:id="@+id/tv_detail_end_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="结束："
                            android:textSize="14sp"
                            android:textColor="@color/text_sub"/>
                    </LinearLayout>

                    <!-- 活动状态 -->
                    <TextView
                        android:id="@+id/tv_detail_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="活动状态："
                        android:textSize="14sp"
                        android:textColor="@color/text_sub"
                        android:layout_marginBottom="6dp"/>

                    <!-- 发布时间 -->
                    <TextView
                        android:id="@+id/tv_detail_publish_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="发布时间："
                        android:textSize="14sp"
                        android:textColor="@color/text_sub"
                        android:layout_marginBottom="16dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_gray"
                        android:layout_marginBottom="16dp"/>

                    <!-- 活动内容 -->
                    <TextView
                        android:id="@+id/tv_detail_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="活动内容..."
                        android:textSize="16sp"
                        android:textColor="@color/text_main"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
