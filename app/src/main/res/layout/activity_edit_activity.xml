<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编辑支教项目"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_main"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改后需重新通过管理员审核"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="项目标题"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_edit_title"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="请输入支教项目名称"
                    android:textColorHint="@color/text_hint"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:maxLines="1" android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支教地址"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_edit_location"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="例如：四川省凉山州昭觉县"
                    android:textColorHint="@color/text_hint"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:maxLines="1" android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支教开始日期"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_edit_start_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="格式：2024-07-01"
                    android:textColorHint="@color/text_hint"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:maxLines="1" android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支教结束日期"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_edit_end_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="格式：2024-08-15"
                    android:textColorHint="@color/text_hint"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:maxLines="1" android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="招募人数"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_edit_num"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="请输入所需志愿者人数"
                    android:inputType="number"
                    android:textColorHint="@color/text_hint"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:maxLines="1" android:singleLine="true"/>

                <!-- 封面图片 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="封面图片（选填）"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <ImageView
                    android:id="@+id/iv_edit_preview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_edittext_rounded"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <Button
                        android:id="@+id/btn_select_edit_image"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="选择封面图片"
                        android:textSize="14sp"
                        android:stateListAnimator="@null"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/bg_white"
                        android:layout_marginEnd="8dp"
                        app:backgroundTint="@null"/>

                    <Button
                        android:id="@+id/btn_clear_edit_image"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="清除图片"
                        android:textSize="14sp"
                        android:stateListAnimator="@null"
                        android:background="@drawable/bg_button_danger"
                        android:textColor="@color/bg_white"
                        android:visibility="gone"
                        app:backgroundTint="@null"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="活动详情"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_edit_content"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:hint="请详细描述以下内容：\n1. 支教教学内容和课程安排\n2. 志愿者要求（学历、年龄、经验等）\n3. 报名截止时间\n4. 发起人联系方式（手机号）\n5. 温馨提示（食宿、交通、注意事项等）"
                    android:gravity="top"
                    android:textColorHint="@color/text_hint"
                    android:padding="15dp"
                    android:background="@drawable/bg_edittext_rounded"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_edit_submit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="20dp"
            android:text="保存修改（需重新审核）"
            android:textColor="@color/bg_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>
