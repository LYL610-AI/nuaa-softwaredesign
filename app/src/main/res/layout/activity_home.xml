<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"> <!-- 统一浅灰背景色 -->

    <!-- 🌟 1. 顶部悬浮搜索栏 -->
    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_edittext_rounded"
                android:hint="输入学校名称或地区搜索"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:maxLines="1"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="56dp"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp"
                android:text="搜索"
                android:textSize="12sp"
                android:textColor="@color/bg_white"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- 隐藏旧的社区入口，防止 Java 报错，功能转移至底部导航 -->
        <ImageButton
            android:id="@+id/btn_goto_community"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 🌟 2. 活动列表区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_activities"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation_bar"
        android:layout_below="@id/rl_header"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:clipToPadding="false" />

    <!-- 🌟 3. 底部四大金刚导航栏 -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/bg_white"
        android:elevation="8dp">

        <!-- 首页 (当前页，文字变蓝高亮) -->
        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="首页"
            android:textSize="12sp"
            android:textColor="@color/primary_blue"
            android:background="@android:color/transparent"
            android:drawableTop="@android:drawable/ic_menu_compass"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@null"/>

        <!-- 主题帖 -->
        <Button
            android:id="@+id/nav_posts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="主题帖"
            android:textSize="12sp"
            android:textColor="@color/text_main"
            android:background="@android:color/transparent"
            android:drawableTop="@android:drawable/ic_menu_agenda"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@null"/>

        <!-- 我的 -->
        <Button
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="我的"
            android:textSize="12sp"
            android:textColor="@color/text_main"
            android:background="@android:color/transparent"
            android:drawableTop="@android:drawable/ic_menu_info_details"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- 隐藏旧的个人中心入口，防止 Java 报错，功能转移至底部导航 nav_profile -->
    <Button
        android:id="@+id/btn_profile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>