<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page_gray"> <!-- 统一浅灰背景 -->

    <!-- 🌟 1. 顶部悬浮标题栏 -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/bg_white"
        android:elevation="3dp"
        android:paddingVertical="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_detail_title_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看主题帖"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />
    </LinearLayout>

    <!-- 🌟 3. 底部固定的评论输入区域 (放在前面方便使用 layout_above) -->
    <!-- 增加了较高的 elevation，使其在底部产生向上的悬浮阴影 -->
    <LinearLayout
        android:id="@+id/layout_comment_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/bg_white"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <!-- 换用统一的圆角输入框 -->
        <EditText
            android:id="@+id/et_comment_input"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="说点什么吧..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:background="@drawable/bg_edittext_rounded"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>

        <!-- 换用胶囊按钮，适当缩小高度以匹配输入框 -->
        <Button
            android:id="@+id/btn_send_comment"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="70dp"
            android:paddingHorizontal="14dp"
            android:text="发送"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bg_white"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_button_primary"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- 🌟 2. 主体滑动区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar"
        android:layout_above="@id/layout_comment_input"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- 【区块 A】帖子详细内容展示卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_post_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="帖子标题"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginBottom="12dp"/>

                    <!-- 补充：作者和时间行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/tv_post_detail_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用户：XXX"
                            android:textSize="13sp"
                            android:textColor="@color/text_sub"
                            android:layout_marginEnd="20dp"/>
                        <TextView
                            android:id="@+id/tv_post_detail_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="时间：202X-XX-XX"
                            android:textSize="13sp"
                            android:textColor="@color/text_sub"/>
                    </LinearLayout>

                    <!-- 帖子图片 -->
                    <ImageView
                        android:id="@+id/iv_post_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:maxHeight="400dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_gray"
                        android:layout_marginBottom="16dp"/>

                    <!-- 补充：正文内容区 -->
                    <TextView
                        android:id="@+id/tv_post_detail_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="这是正文内容的占位符。在 Java 代码中可以通过 findViewById(R.id.tv_post_detail_content) 来设置具体的帖子内容..."
                        android:textSize="16sp"
                        android:textColor="@color/text_main"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 【区块 B】评论区卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="全部评论"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:paddingHorizontal="20dp"
                        android:layout_marginBottom="10dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_gray"/>

                    <!-- 评论列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_comments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>